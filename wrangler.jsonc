{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safety-theatre",
  "compatibility_date": "2026-08-01",
  // Pure static multi-page site served straight from Cloudflare's asset host — no Worker script needed.
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "safetytheatre.theradicalparty.com", "custom_domain": true }]
}
